{
  "GatewayInternal": {
    "Authority": "https://gateway-aspire.dev.localhost:5800",
    "Audience": "gateway-internal"
  },
  "FeatureManagement": {
    "V1Api": true,
    "StrictJwtAudience": true
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "SerilogStepUp": {
    "BaseLevel": "Warning",
    "StepUpLevel": "Information",
    "DurationSeconds": 60,
    "MaxContinuousStepUpSeconds": 600,
    "StepUpCooldownSeconds": 300,
    "TreatServerErrorStatusAsError": false,
    "AlwaysLogRequestSummary": true,
    "CaptureRequestBody": false,
    "ExcludePaths": [
      "/health",
      "/alive",
      "/metrics",
      "/api/scalar.js",
      "/api/scalar.aspnetcore.js"
    ]
  }
}