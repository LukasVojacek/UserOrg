@inherits LayoutComponentBase

<div class="rm-shell">
    <header class="rm-header">
        <div class="rm-title">Dashboard</div>
    </header>

    <main class="rm-body">
        @Body
    </main>
</div>

<style>
    .rm-shell { display: flex; flex-direction: column; min-height: 100vh; font-family: "Segoe UI", Tahoma, sans-serif; background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 65%, #e0f2fe 100%); color: #111827; }
    .rm-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid rgba(0, 0, 0, 0.06); position: sticky; top: 0; backdrop-filter: blur(8px); background: rgba(248, 250, 252, 0.9); z-index: 10; }
    .rm-title { font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; font-size: 0.95rem; color: #0f766e; }
    .rm-nav a { color: #0f172a; text-decoration: none; font-weight: 600; }
    .rm-body { padding: 1.5rem; max-width: 1400px; width: 100%; margin: 0 auto; }
    .rm-container { width: 100%; }
    .rm-page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
    .rm-page-title { font-size: 1.75rem; font-weight: 700; color: #0f172a; margin: 0; }
    .rm-page-actions { display: flex; gap: 0.5rem; align-items: center; }
    .rm-card { background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.05); border-radius: 12px; padding: 1.25rem; box-shadow: 0 14px 40px rgba(15, 23, 42, 0.08); margin-bottom: 1rem; }
    .rm-grid { display: grid; grid-template-columns: 1fr 350px; gap: 1.5rem; }
    .rm-grid-main { display: flex; flex-direction: column; gap: 1rem; }
    .rm-grid-sidebar { display: flex; flex-direction: column; gap: 1rem; }
    .rm-section-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; color: #0f766e; letter-spacing: 0.2px; }
    .rm-table { width: 100%; border-collapse: collapse; }
    .rm-table th, .rm-table td { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid rgba(0, 0, 0, 0.06); }
    .rm-table th { color: #475569; font-weight: 600; font-size: 0.85rem; }
    .rm-table td { color: #0f172a; font-size: 0.9rem; }
    .rm-pill { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.5rem; background: rgba(14, 116, 144, 0.12); border: 1px solid rgba(14, 116, 144, 0.35); border-radius: 999px; font-size: 0.78rem; color: #0f766e; }
    .rm-input, .rm-select, .rm-textarea { width: 100%; padding: 0.55rem 0.65rem; border-radius: 8px; background: #f8fafc; color: #0f172a; border: 1px solid rgba(0, 0, 0, 0.1); font-family: inherit; }
    .rm-input:focus, .rm-select:focus, .rm-textarea:focus { outline: 2px solid #0ea5e9; outline-offset: 2px; }
    .rm-button { background: linear-gradient(135deg, #0ea5e9, #0f766e); color: #fff; border: none; padding: 0.65rem 0.9rem; border-radius: 10px; font-weight: 700; cursor: pointer; box-shadow: 0 10px 25px rgba(14, 165, 233, 0.35); font-family: inherit; }
    .rm-button.secondary { background: transparent; border: 1px solid rgba(0, 0, 0, 0.12); color: #0f172a; box-shadow: none; }
    .rm-button:disabled { opacity: 0.5; cursor: not-allowed; }
    .rm-button:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(14, 165, 233, 0.45); }
    .rm-badge { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.5rem; background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.35); border-radius: 999px; font-size: 0.78rem; color: #166534; }
    .rm-alert { padding: 0.75rem 1rem; border-radius: 10px; border: 1px solid rgba(248, 113, 113, 0.4); background: rgba(248, 113, 113, 0.1); color: #7f1d1d; margin-bottom: 1rem; }
    .rm-success { padding: 0.75rem 1rem; border-radius: 10px; border: 1px solid rgba(34, 197, 94, 0.4); background: rgba(34, 197, 94, 0.1); color: #166534; margin-bottom: 1rem; }
    .rm-info { color: #1e40af; font-size: 0.95rem; }
    .rm-help-text { font-size: 0.8rem; color: #64748b; margin-top: 0.25rem; }
    .rm-empty { text-align: center; padding: 2rem; color: #64748b; font-size: 0.9rem; }
    .rm-loading { text-align: center; padding: 3rem; color: #0f766e; font-size: 1.1rem; font-weight: 600; }
    .rm-search { width: 100%; padding: 0.55rem 0.65rem; border-radius: 8px; background: #f8fafc; color: #0f172a; border: 1px solid rgba(0, 0, 0, 0.1); font-family: inherit; margin-bottom: 1rem; }
    .rm-search:focus { outline: 2px solid #0ea5e9; outline-offset: 2px; }
    .rm-card-header { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1rem; }
    .rm-card-header h2 { margin: 0; font-size: 1.1rem; font-weight: 700; color: #0f766e; }
    .rm-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .rm-list-item { padding: 0.75rem; border: 1px solid rgba(0, 0, 0, 0.06); border-radius: 8px; cursor: pointer; transition: all 0.2s ease; background: #ffffff; }
    .rm-list-item:hover { background: #f8fafc; border-color: #0ea5e9; transform: translateX(2px); }
    .rm-list-item.selected { background: #e0f2fe; border-color: #0ea5e9; box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.1); }
    .rm-list-item-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
    .rm-list-item-title { font-weight: 600; color: #0f172a; }
    .rm-list-item-body { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 0.5rem; }
    .rm-list-item-actions { display: flex; gap: 0.5rem; justify-content: flex-end; }
    .rm-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem; }
    .rm-tag { display: inline-flex; padding: 0.15rem 0.4rem; background: rgba(14, 165, 233, 0.1); border: 1px solid rgba(14, 165, 233, 0.25); border-radius: 4px; font-size: 0.75rem; color: #0369a1; }
    .rm-form-group { margin-bottom: 1rem; }
    .rm-form-group label { display: block; font-weight: 600; color: #334155; margin-bottom: 0.4rem; font-size: 0.9rem; }
    .rm-form-actions { display: flex; gap: 0.75rem; margin-top: 1.5rem; }
    .rm-button.danger { background: linear-gradient(135deg, #ef4444, #dc2626); box-shadow: 0 10px 25px rgba(239, 68, 68, 0.35); }
    .rm-button.danger:hover:not(:disabled) { box-shadow: 0 12px 30px rgba(239, 68, 68, 0.45); }
    .rm-badge.success { background: rgba(34, 197, 94, 0.15); border-color: rgba(34, 197, 94, 0.35); color: #166534; }
    .rm-badge.info { background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.35); color: #1e40af; }
    .rm-badge.warning { background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.35); color: #92400e; }
    .rm-badge.danger { background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.35); color: #991b1b; }
    .rm-badge.secondary { background: rgba(100, 116, 139, 0.15); border-color: rgba(100, 116, 139, 0.35); color: #475569; }
    .rm-checkbox-list { display: flex; flex-direction: column; gap: 0.5rem; max-height: 300px; overflow-y: auto; padding: 0.5rem; background: #f8fafc; border-radius: 8px; border: 1px solid rgba(0, 0, 0, 0.06); }
    .rm-checkbox-item { display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.4rem; cursor: pointer; }
    .rm-checkbox-item:hover { background: rgba(14, 165, 233, 0.05); border-radius: 6px; }
    .rm-checkbox-item input[type="checkbox"] { margin-top: 0.15rem; cursor: pointer; }
    .rm-checkbox-item small { display: block; color: #64748b; font-size: 0.75rem; }
    .rm-permission-tree details { margin: 0.5rem 0; }
    .rm-permission-tree summary { cursor: pointer; font-weight: 600; color: #0f766e; padding: 0.5rem; background: #f8fafc; border-radius: 6px; margin-bottom: 0.5rem; }
    .rm-permission-tree summary:hover { background: #e0f2fe; }
    .rm-permission-group { padding-left: 1rem; }
    .rm-toast { position: fixed; top: 20px; right: 20px; padding: 1rem 1.5rem; border-radius: 10px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); z-index: 1000; display: flex; align-items: center; gap: 1rem; max-width: 400px; animation: slideIn 0.3s ease; }
    .rm-toast--success { background: #10b981; color: white; }
    .rm-toast--error { background: #ef4444; color: white; }
    .rm-toast--info { background: #3b82f6; color: white; }
    .rm-toast-close { background: transparent; border: none; color: inherit; font-size: 1.5rem; font-weight: 700; cursor: pointer; padding: 0; line-height: 1; opacity: 0.8; }
    .rm-toast-close:hover { opacity: 1; }
    .rm-dialog-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; z-index: 999; animation: fadeIn 0.2s ease; }
    .rm-dialog { background: white; padding: 2rem; border-radius: 12px; max-width: 500px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3); animation: scaleIn 0.3s ease; }
    .rm-dialog h3 { margin-top: 0; color: #0f172a; }
    .rm-dialog-actions { display: flex; gap: 0.75rem; margin-top: 1.5rem; justify-content: flex-end; }
    @@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes scaleIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    @@media (max-width: 1024px) {
        .rm-grid { grid-template-columns: 1fr; }
    }
</style>

