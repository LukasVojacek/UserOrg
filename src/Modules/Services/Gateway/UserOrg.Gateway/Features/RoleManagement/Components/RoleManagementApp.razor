@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @inject UserOrg.Gateway.Features.RoleManagement.RoleManagementOptions _rmOptions
    <base href="@(string.IsNullOrWhiteSpace(_rmOptions.PathPrefix) ? "/" : (_rmOptions.PathPrefix.EndsWith("/") ? _rmOptions.PathPrefix : _rmOptions.PathPrefix + "/"))" />
    <HeadOutlet />
    <PageTitle>Role Management</PageTitle>
</head>
<body>
    <Router AppAssembly="@typeof(RoleManagementApp).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <p class="text-danger">Your role management session has ended. Open the console with the access token again.</p>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p class="text-danger">Requested page could not be found.</p>
            </LayoutView>
        </NotFound>
    </Router>

    <script src="_framework/blazor.web.js"></script>
    <script>
        // Pause circuit when tab is hidden, resume when visible
        // This saves server resources by evicting inactive circuits
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'hidden') {
                Blazor.pause();
            } else if (document.visibilityState === 'visible') {
                Blazor.resume();
            }
        });

        // Helper function for downloading files from Blazor
        window.downloadFile = function(fileName, base64Data) {
            const link = document.createElement('a');
            link.download = fileName;
            link.href = 'data:application/json;base64,' + base64Data;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };
    </script>
</body>
</html>
