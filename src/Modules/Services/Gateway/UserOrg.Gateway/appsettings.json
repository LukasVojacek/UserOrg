{
  "AllowedHosts": "*",
  "DefaultUserRoleName": "User",
  "DefaultAdminRoleName": "Admin",
  "RoleManagement": {
    "AccessToken": null,
    "CookieExpirationMinutes": 60,
    "CookieName": "RoleManagementAuth",
    "AdminRoles": [
      "Admin",
      "SystemAdmin"
    ]
  },
  "ServiceToService": {
    "Routes": [
      {
        "Target": "forge-api",
        "AllowedCallers": [
          "userorg",
          "gateway"
        ]
      }
    ]
  },
  "ApiKeyAuthentication": {
    "TimeoutSeconds": 15
  },
  "FeatureManagement": {
    "StrictJwtAudience": true
  }
}