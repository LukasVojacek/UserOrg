{
 "ConnectionStrings":
    {
        "Default": "Data Source=/opt/database/emailsQueueDev.db"
    },
  "MailSettings":
  {
    "Server": "mailpit",
    "Port": 1025,
    "UseAuthenticationToSmtp": false,
    "UseSsl": false,
    "UserName": "Your username",
    "Password": "Your password"
  },
  "ApplicationSettings":
  {
    "MaxResendTries": 5,
    "BackgroundSenderPeriodMinutes": 0.3,
    "TemplatePath": "/opt/emailTemplates/"
  },
  "IpAddressWhitelist":
  {
    "Sources":
    [
      {
        "Description": "localhost",
        "Ip": "127.0.0.1"
      },
        {
            "Description": "localhostV6",
            "Ip": "::1"
        },
      {
        "Description": "any",
        "Ip": "*"
      }
    ]
  },
  "SwaggerConfiguration":
  {
    "Version": "v1.0.0",
    "Title": "Emial sender Api",
    "Description": "Emial sender Api",
    "Host": "http://localhost:8088",
    "HostPostfix": "",
    "PrefixDocPath": "swagger",
    "TermOfUsageUrl": "https://twitter.com/it4innovations",
    "License": "GNU General Public License v3.0",
    "LicenseUrl": "https://www.gnu.org/licenses/gpl-3.0.html",
    "ContactName": "IT4Innovations",
    "ContactEmail": "",
    "ContactUrl": "https://twitter.com/it4innovations"
  },
  "Serilog":
  {
    "Using":
    [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel":
    {
      "Default": "Information",
      "Override":
      {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo":
    [
      {
        "Name": "Console",
        "Args":
        {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args":
        {
          "path": "/opt/logs/log-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3}] {Username} {Message:lj}{NewLine}{Exception}",
          "formatter":
          {
            "type": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      }
    ],
    "Enrich":
    [
      "FromLogContext",
      "WithMachineName"
    ]
  }
}