  },
  "paths": {
    "/api/v2/Providers": {
      "post": {
        "tags": [
          "Provider"
        ],
        "summary": "Create a provider",
        "description": "Creates a provider (Admin only). Body {Name, CountryCode, Description?, SupportEmail?, IsPrivate}. Returns 201; 400 on validation / unknown country; 403 for non-Admins; 409 when the name already exists.",
        "operationId": "CreateProviderV2",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProviderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateProviderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/v2/Providers/{providerName}": {
      "delete": {
        "tags": [
          "Provider"
        ],
        "summary": "Deactivate a provider",
        "description": "Soft-deletes a provider (Admin or the owning provider identity). Returns 204; 403 when not allowed; 404 when the provider does not exist; 409 when it is already deactivated.",
        "operationId": "DeactivateProviderV2",
        "parameters": [
          {
            "name": "providerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/v2/Users": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "List users",
        "description": "Returns users, optionally filtered by project short name or identity provider user ID.",
        "operationId": "GetUsersV2",
        "parameters": [
          {
            "name": "ProjectShortName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "IdpUserId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "Limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetUsersResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/v2/Users/{idpUserId}/ProviderAdmin/{providerName}": {
      "put": {
        "tags": [
          "User"
        ],
        "summary": "Promote a user to ProviderAdmin",
        "description": "Promotes a user to the ProviderAdmin system role bound to the named provider (Admin only). Returns 204; 403 for non-admins; 404 when the user or provider does not exist; 409 when the target is an administrator (the Admin role cannot be changed).",
        "operationId": "PromoteToProviderAdminV2",
        "parameters": [
          {
            "name": "idpUserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/v2/Users/{idpUserId}/ProviderAdmin": {
      "delete": {
        "tags": [
          "User"
        ],
        "summary": "Reset a user to platform User",
        "description": "Resets a user from ProviderAdmin back to the platform User role, unassigning their provider(s) first (Admin only). Returns 204; 403 for non-admins; 404 when the user does not exist; 409 when the target is an administrator (the Admin role cannot be changed).",
        "operationId": "ResetToPlatformUserV2",
        "parameters": [
          {
            "name": "idpUserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/v2/ProjectTags/{tagName}": {
      "delete": {
        "tags": [
          "ProjectTag"
        ],
        "summary": "Delete a project tag",
        "description": "Soft-deletes a shared catalogue tag (Admin only). Returns 204; 400 on an invalid name; 403 for non-admins; 404 when the tag does not exist; 409 when the tag is still assigned to an active project.",
        "operationId": "DeleteProjectTagV2",
        "parameters": [
          {
            "name": "tagName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { }
        ]
      }
    },
    "/api/v2/Caches": {
      "delete": {
        "tags": [
          "Cache"
        ],
        "summary": "Reset all caches",
        "description": "Flushes the entire v2 output cache (Admin only). Returns 204; 403 for non-admins.",
        "operationId": "ResetAllCachesV2",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          { }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateProviderRequest": {
        "required": [
          "Name",
          "CountryCode",
          "Description",
          "SupportEmail",
          "IsPrivate"
        ],
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "CountryCode": {
            "type": "string"
          },
          "Description": {
            "type": [
              "null",
              "string"
            ]
          },
          "SupportEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "IsPrivate": {
            "type": "boolean"
          }
        }
      },
      "CreateProviderResponse": {
        "required": [
          "Name"
        ],
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          }
        }
      },
      "GetUsersResponse": {
        "required": [
          "IdpUserId",
          "Email",
          "UserName",
          "Projects",
          "AssignedProviderName"
        ],
        "type": "object",
        "properties": {
          "IdpUserId": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "UserName": {
            "type": "string"
          },
          "Projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "AssignedProviderName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "Type": {
            "type": [
              "null",
              "string"
            ]
          },
          "Title": {
            "type": [
              "null",
              "string"
            ]
          },
          "Status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "Detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "Instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "Errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "Type": {
            "type": [
              "null",
              "string"
            ]
          },
          "Title": {
            "type": [
              "null",
              "string"
            ]
          },
          "Status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "Detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "Instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Paste only the JWT access token. The Bearer prefix is applied automatically.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "Service": {
        "type": "apiKey",
        "description": "Paste only the service token in format: Service TOKEN/KEY",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "tags": [
    {
      "name": "Provider"
    },
    {
      "name": "User"
    },
    {
      "name": "ProjectTag"
    },
    {
      "name": "Cache"
    }
  ]
}