{
  "openapi": "3.1.1",
  "info": {
    "title": "UserOrg API v0.0.0.1",
    "description": "UserOrg Management API",
    "contact": {
      "name": "IT4Innovations",
      "url": "https://opencode.it4i.eu/lexis-platform/backend/userorg",
      "email": "support@lexis.tech"
    },
    "license": {
      "name": "Apache-2.0",
