# Shell scripts must stay LF regardless of core.autocrlf (they run in Linux containers)
*.sh text eol=lf

# Squad: union merge for append-only team state files
.ai-team/decisions.md merge=union
.ai-team/agents/*/history.md merge=union
.ai-team/log/** merge=union
.ai-team/orchestration-log/** merge=union
# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union

# Line endings: standardize on LF for all text files (binary auto-detected and left untouched)
* text=auto eol=lf
